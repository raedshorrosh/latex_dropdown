[[iframe width="100%" height="450px"]]

<!-- 1. The hidden variables injected by STACK Maxima -->
<div style="display: none;">
    <div id="data-tas">{#js_tas#}</div>
    <div id="data-options">{#js_options#}</div>
    <div id="data-titles">{#js_titles#}</div>
    <div id="data-types">{#js_types#}</div>
    <div id="data-weights">{#js_weights#}</div>
    <div id="data-input-ans">{#js_input_ans#}</div>
</div>

<!-- 2. The mount point where the React application will draw itself -->
<div id="root"></div>

<!-- 3. Load the STACK API Bridge -->
[[script type="module"]]
    import {stack_js} from '[[cors src="stackjsiframe.js"/]]';
    window.stack_js = stack_js;
[[/script]]

